#!/usr/bin/env bash
set -e

NODE_DIR="/opt/nodex-node"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

ensure_dir() {
    if [ ! -d "$NODE_DIR" ]; then
        echo -e "${RED}未找到安装目录 $NODE_DIR${NC}"
        exit 1
    fi
    cd "$NODE_DIR"
}

show_status() {
    ensure_dir
    echo -e "${CYAN}--- 容器运行状态 ---${NC}"
    docker compose ps
    echo -e "${CYAN}--- 节点运行详情 ---${NC}"
    docker exec nodex-node python3 /app/agent.py --status 2>/dev/null || echo -e "${YELLOW}容器未运行，无法读取实时状态${NC}"
}

start_node() {
    ensure_dir
    docker compose up -d
    echo -e "${GREEN}nodex-node 已启动${NC}"
}

stop_node() {
    ensure_dir
    docker compose down
    echo -e "${YELLOW}nodex-node 已停止并通知控制面下线${NC}"
}

restart_node() {
    ensure_dir
    docker compose restart
    echo -e "${GREEN}nodex-node 已重启${NC}"
}

edit_limits() {
    ensure_dir
    touch .env
    cur_bw=$(grep -E '^MAX_BW_MBPS=' .env | cut -d= -f2 || echo "30")
    cur_gb=$(grep -E '^MAX_MONTHLY_GB=' .env | cut -d= -f2 || echo "500")
    echo -e "当前带宽限速: ${CYAN}${cur_bw:-30} Mbps${NC}，月流量上限: ${CYAN}${cur_gb:-500} GB${NC}"
    read -rp "请输入新的带宽限速 (Mbps, 0=不限速, 回车保持不变): " new_bw
    read -rp "请输入新的月流量上限 (GB, 0=不限制, 回车保持不变): " new_gb

    if [ -n "$new_bw" ]; then
        if grep -q '^MAX_BW_MBPS=' .env; then
            sed -i "s/^MAX_BW_MBPS=.*/MAX_BW_MBPS=${new_bw}/" .env
        else
            echo "MAX_BW_MBPS=${new_bw}" >> .env
        fi
    fi
    if [ -n "$new_gb" ]; then
        if grep -q '^MAX_MONTHLY_GB=' .env; then
            sed -i "s/^MAX_MONTHLY_GB=.*/MAX_MONTHLY_GB=${new_gb}/" .env
        else
            echo "MAX_MONTHLY_GB=${new_gb}" >> .env
        fi
    fi
    docker exec nodex-node python3 /app/agent.py --sync >/dev/null 2>&1 || true
    docker compose restart
    echo -e "${GREEN}限速与流量配额已更新并立即生效！${NC}"
}

sync_now() {
    ensure_dir
    echo -e "${CYAN}正在同步公网 IP 与后台限速配置...${NC}"
    docker exec nodex-node python3 /app/agent.py --sync
}

view_logs() {
    ensure_dir
    echo -e "${YELLOW}按 Ctrl+C 退出日志查看${NC}"
    docker compose logs -f --tail=100
}

update_node() {
    ensure_dir
    if [ -d ".git" ]; then
        echo -e "${CYAN}正在从 GitHub 拉取最新版本（自动保留 .env 与节点身份）...${NC}"
        git pull --ff-only
        docker compose up -d --build
        cp -f "$NODE_DIR/nodex" /usr/local/bin/nodex
        chmod +x /usr/local/bin/nodex
        echo -e "${GREEN}更新完成！${NC}"
    else
        echo -e "${YELLOW}当前目录不是 Git 仓库，请覆盖上传新版文件后执行: cd $NODE_DIR && docker compose up -d --build${NC}"
    fi
}

uninstall_node() {
    ensure_dir
    read -rp "确定彻底卸载 nodex-node 并删除数据吗？[y/N]: " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
        docker compose down -v --rmi local || true
        rm -rf "$NODE_DIR" /usr/local/bin/nodex
        echo -e "${GREEN}nodex-node 已彻底卸载（不影响宿主机其他服务）${NC}"
        exit 0
    fi
}

show_menu() {
    clear
    echo -e "${CYAN}=========================================${NC}"
    echo -e "${CYAN}     NodeXProtocol 边缘节点管理后台      ${NC}"
    echo -e "${CYAN}=========================================${NC}"
    echo -e "  ${GREEN}1.${NC} 启动节点"
    echo -e "  ${GREEN}2.${NC} 停止节点"
    echo -e "  ${GREEN}3.${NC} 重启节点"
    echo -e "  ${GREEN}4.${NC} 修改带宽限速 (Mbps) 与月流量上限 (GB)"
    echo -e "  ${GREEN}5.${NC} 查看节点状态 (公网 IP / 流量 / 限速)"
    echo -e "  ${GREEN}6.${NC} 立即与控制面同步 (拉取后台调速/上报IP)"
    echo -e "  ${GREEN}7.${NC} 查看实时运行日志"
    echo -e "  ${GREEN}8.${NC} 一键从 GitHub 更新"
    echo -e "  ${RED}9.${NC} 卸载 nodex-node"
    echo -e "  ${YELLOW}0.${NC} 退出菜单"
    echo -e "${CYAN}=========================================${NC}"
    read -rp "请输入选项 [0-9]: " choice
    case "$choice" in
        1) start_node ;;
        2) stop_node ;;
        3) restart_node ;;
        4) edit_limits ;;
        5) show_status ;;
        6) sync_now ;;
        7) view_logs ;;
        8) update_node ;;
        9) uninstall_node ;;
        0) exit 0 ;;
        *) echo -e "${RED}无效选项${NC}" ;;
    esac
}

case "${1:-}" in
    start) start_node ;;
    stop) stop_node ;;
    restart) restart_node ;;
    status) show_status ;;
    sync) sync_now ;;
    logs) view_logs ;;
    update) update_node ;;
    *)
        while true; do
            show_menu
            echo ""
            read -rp "按回车返回菜单..." _
        done
        ;;
esac
